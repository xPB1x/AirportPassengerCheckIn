
@model List<AirportPassengerCheckIn.DTOs.ViewModels.Aircrafts.AircraftTypeViewModel>

@{
    ViewData["Title"] = "Типы самолётов";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Справочник типов самолётов</h2>

        <a asp-action="Create" class="btn btn-primary">
            Добавить тип самолёта
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Справочник типов самолётов пока пуст.
        </div>
    }
    else
    {
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }
        <table class="table table-bordered table-striped align-middle">
            <thead>
                <tr>
                    <th>Производитель</th>
                    <th>Модель</th>
                    <th>Количество мест</th>
                    <th>Количество самолётов</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var aircraftType in Model)
                {
                    <tr>
                        <td>@aircraftType.Company</td>
                        <td>@aircraftType.Model</td>
                        <td>@aircraftType.NumberOfSeats</td>
                        <td>@aircraftType.AircraftCount</td>
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@aircraftType.Id"
                               class="btn btn-sm btn-primary">
                                Изменить
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
