@model AirportPassengerCheckIn.DTOs.ViewModels.UserListViewModel

@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Управление пользователями</h2>

        <a asp-controller="Users"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Добавить пользователя
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Роль</th>
                    <th>ФИО сотрудника</th>
                    <th>Должность</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Users.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            Пользователи не найдены
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.Email</td>

                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-secondary me-1">
                                        @role
                                    </span>
                                }
                            </td>

                            <td>
                                @(user.EmployeeFullName ?? "—")
                            </td>

                            <td>
                                @(user.Position ?? "—")
                            </td>

                            <td>
                                @if (user.IsLocked)
                                {
                                    <span class="badge bg-danger">
                                        Заблокирован
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Активен
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Users"
                                   asp-action="Edit"
                                   asp-route-id="@user.UserId"
                                   class="btn btn-sm btn-outline-primary">
                                    Изменить
                                </a>
                                @if (!user.IsLocked)
                                {
                                    <form asp-action="Block"
                                          asp-route-id="@user.UserId"
                                          method="post"
                                          class="d-inline">

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Заблокировать пользователя?')">
                                            Заблокировать
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Unblock"
                                          asp-route-id="@user.UserId"
                                          method="post"
                                          class="d-inline">

                                        <button type="submit"
                                                class="btn btn-sm btn-success"
                                                onclick="return confirm('Восстановить доступ пользователя?')">
                                            Восстановить
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <span class="text-muted">
            Всего пользователей: @Model.Users.Count
        </span>
    </div>
</div>
