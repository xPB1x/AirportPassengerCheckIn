@model List<AirportPassengerCheckIn.DTOs.ViewModels.Flights.FlightViewModel>

@{
    ViewData["Title"] = "Типы самолётов";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Справочник рейсов</h2>

        <a asp-action="Create" class="btn btn-primary">
            Добавить рейс
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Справочник рейсов пуст.
        </div>
    }
    else
    {
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }
        <table class="table table-bordered table-striped align-middle">
            <thead>
                <tr>
                    <th>Номер рейса</th>
                    <th>Вылет</th>
                    <th>Прибытие</th>
                    <th>Самолет</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var flight in Model)
                {
                    <tr>
                        <td>@flight.FlightNumber</td>

                        <td>
                            @flight.DepartureAirportCity
                            (@flight.DepartureAirportCode)
                            <br />
                            @flight.DepartureTime.ToString("dd.MM.yyyy HH:mm")
                        </td>

                        <td>
                            @flight.ArrivalAirportCity
                            (@flight.ArrivalAirportCode)
                            <br />
                            @flight.ArrivalTime.ToString("dd.MM.yyyy HH:mm")
                        </td>

                        <td>
                            @flight.AircraftNumber
                            <br />
                            @flight.AircraftCompany
                            @flight.AircraftModel
                        </td>
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@flight.Id"
                               class="btn btn-sm btn-primary">
                                Изменить
                            </a>
                            <form asp-action="Delete"
                                  asp-route-id="@flight.Id"
                                  method="post"
                                  class="d-inline">

                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Удалить рейс?')">
                                    Удалить
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
