@model AirportPassengerCheckIn.DTOs.ViewModels.Flights.CreateFlightViewModel

@{
    ViewData["Title"] = "Добавление рейса";
}

<div class="container mt-4">
    <h2 class="mb-4">Добавление рейса</h2>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="FlightNumber" class="form-label"></label>
            <input asp-for="FlightNumber" class="form-control" />
            <span asp-validation-for="FlightNumber"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DepartureAirportId" class="form-label"></label>
            <select asp-for="DepartureAirportId"
                    asp-items="Model.Airports"
                    class="form-select">
                <option value="0">Выберите аэропорт вылета</option>
            </select>
            <span asp-validation-for="DepartureAirportId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ArrivalAirportId" class="form-label"></label>
            <select asp-for="ArrivalAirportId"
                    asp-items="Model.Airports"
                    class="form-select">
                <option value="0">Выберите аэропорт прибытия</option>
            </select>
            <span asp-validation-for="ArrivalAirportId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DepartureTime" class="form-label"></label>
            <input asp-for="DepartureTime"
                   type="datetime-local"
                   class="form-control" />
            <span asp-validation-for="DepartureTime"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ArrivalTime" class="form-label"></label>
            <input asp-for="ArrivalTime"
                   type="datetime-local"
                   class="form-control" />
            <span asp-validation-for="ArrivalTime"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AircraftId" class="form-label"></label>
            <select asp-for="AircraftId"
                    asp-items="Model.Aircrafts"
                    class="form-select">
                <option value="0">Выберите самолёт</option>
            </select>
            <span asp-validation-for="AircraftId"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Добавить рейс
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Назад
        </a>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
