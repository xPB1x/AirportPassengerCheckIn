@{
    ViewData["Title"] = "Регистрация пассажиров";
}

<div class="container mt-4">
    <h2>Регистрация пассажиров на стойке</h2>

    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Поиск пассажира</h5>

            <form asp-action="BookingSearchResults" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="passportNumber" class="form-label">
                        Номер паспорта
                    </label>

                    <input type="text"
                           id="passportNumber"
                           name="passportNumber"
                           class="form-control"
                           placeholder="Введите номер паспорта"
                           required />
                </div>

                <button type="submit" class="btn btn-primary">
                    Найти
                </button>
            </form>
        </div>
    </div>
</div>
