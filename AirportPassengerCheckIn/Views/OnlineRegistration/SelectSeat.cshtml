@model AirportPassengerCheckIn.DTOs.ViewModels.Registrations.SelectSeatViewModel
@using AirportPassengerCheckIn.Models.Enums

@{
    ViewData["Title"] = "Выбор места";
}

<div class="container mt-4">
    <h2>Выбор места</h2>

    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Информация о рейсе</h5>

            <dl class="row mt-3">
                <dt class="col-sm-4">Номер бронирования</dt>
                <dd class="col-sm-8">@Model.BookingNumber</dd>

                <dt class="col-sm-4">Рейс</dt>
                <dd class="col-sm-8">@Model.FlightNumber</dd>

                <dt class="col-sm-4">Пассажир</dt>
                <dd class="col-sm-8">@Model.PassengerName</dd>

                <dt class="col-sm-4">Маршрут</dt>
                <dd class="col-sm-8">
                    @Model.DepartureAirport — @Model.ArrivalAirport
                </dd>

                <dt class="col-sm-4">Время отправления</dt>
                <dd class="col-sm-8">
                    @Model.DepartureTime.ToString("dd.MM.yyyy HH:mm")
                </dd>
            </dl>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Выбор места</h5>

            <form asp-action="ConfirmSelectSeat" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="BookingPassengerId" />

                <div class="mb-3">
                    <label asp-for="SelectedSeatId" class="form-label">
                        Место
                    </label>

                    <select asp-for="SelectedSeatId" class="form-select" required>
                        <option value="">Выберите место</option>

                        @foreach (var seatClass in Enum.GetValues<SeatClass>())
                        {
                            var seatsInClass = Model.Seats
                                .Where(s => s.Class == seatClass)
                                .ToList();

                            if (seatsInClass.Any())
                            {
                                <optgroup label="@seatClass">
                                    @foreach (var seat in seatsInClass)
                                    {
                                        <option value="@seat.Id"
                                                disabled="@seat.IsOccupied">
                                            @seat.SeatNumber
                                            @(seat.IsOccupied ? " — занято" : "")
                                        </option>
                                    }
                                </optgroup>
                            }
                        }
                    </select>

                    <span asp-validation-for="SelectedSeatId"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Подтвердить выбор
                    </button>

                    <a asp-action="OnlineBookings" class="btn btn-secondary">
                        Назад
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3 text-muted small">
        Занятые места нельзя выбрать.
    </div>
</div>
